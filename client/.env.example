# Express backend used by the Vite dev-server proxy (/api, /uploads)
VITE_BACKEND_URL=http://localhost:5000

# Base URL the browser uses for API calls. Leave as /api in development (goes through the proxy).
# On Vercel set it to the backend project's URL + /api, e.g. https://sagarnetra-api.vercel.app/api
# (Vite bakes it in at build time: redeploy after changing it.)
VITE_API_URL=/api
