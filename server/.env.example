# ---- server ----
# On Vercel: NODE_ENV=production (PORT and PUBLIC_URL are not used there)
NODE_ENV=development
PORT=5000
# Origins allowed to call the API: the React app (comma-separated), e.g. https://sagarnetra.vercel.app
CLIENT_ORIGINS=http://localhost:3000
# Base URL used for links to locally stored files (only when STORAGE_PROVIDER falls back to local)
PUBLIC_URL=http://localhost:5000
MAX_UPLOAD_MB=100
RATE_LIMIT_PER_MINUTE=300

# ---- database ----
# On Vercel: a MongoDB Atlas URI (Network Access must allow 0.0.0.0/0), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sonarscan?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sonarscan

# ---- AI microservice (FastAPI, ai/) ----
# On Vercel: the AI project's URL, e.g. https://sagarnetra-ai.vercel.app, and a timeout below the
# 300 s function limit (AI_TIMEOUT_MS=280000)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=300000
# Same value as the AI service's SONAR_API_KEY (leave empty locally)
AI_API_KEY=

# ---- file storage ----
# cloudinary | local  (cloudinary falls back to local automatically while the keys below are empty)
# Required on Vercel: serverless disks are temporary, and files over 4.5 MB are uploaded by the
# browser straight to Cloudinary (signed by this API).
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sonarscan
