# Synthetic survey data: 56 XTF lines (~490 MB) are regenerated with ai/tools/generate_xtf.py.
# Only three demo lines are versioned; labels, navigation, manifest and previews are all kept.
data/synthetic_xtf/**/*.xtf
!data/synthetic_xtf/AND/AND-L03.xtf
!data/synthetic_xtf/VIZ/VIZ-L03.xtf
!data/synthetic_xtf/CHN/CHN-L02.xtf

# Duplicate training checkpoints (best.pt / best.onnx are the ones the service loads)
ai/models/**/last.pt


