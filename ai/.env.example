# SagarNetra AI service settings (copy to ai/.env locally, or set in the Vercel project).

# auto = PyTorch if Ultralytics is installed, else onnxruntime (Vercel). Or force: pt | onnx
SONAR_BACKEND=auto
# auto | cpu | 0 (first CUDA GPU); only used by the PyTorch backend
SONAR_DEVICE=auto
SONAR_MAX_UPLOAD_MB=300
# Shared secret with the backend (its AI_API_KEY). Set it in production so only your backend can run inference.
SONAR_API_KEY=
# The Express backend's origin(s); the browser never calls this service directly
SONAR_CORS_ORIGINS=http://localhost:3000,http://localhost:5000
# Hosts the service may download input files from (large files are uploaded to Cloudinary first)
SONAR_FETCH_HOSTS=res.cloudinary.com
# Longest side of result images embedded in responses. On Vercel use 2560 to stay under the 4.5 MB limit.
SONAR_PREVIEW_MAX_SIDE=4096
SONAR_PREVIEW_QUALITY=85
